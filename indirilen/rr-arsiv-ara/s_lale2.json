rce=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Ambassadeur_Cornelis_Calkoen_op_audi%C3%ABntie_bij_sultan_Ahmed_III_Rijksmuseum_SK-A-4078.jpeg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=34321151","extmetadata":{"ImageDescription":{"value":"Ambassadeur Cornelis Calkoen op audi\u00ebntie bij sultan Ahmed III, 14 september 1727. Uiterst links spreekt de grootvizier de ambassadeur toe. Links zit de sultan op zijn troon. Rechts de ambassadeur met zijn gevolg en Turkse ambtsdragers. Onderdeel van een reeks schilderijen met Turkse onderwerpen uit Turkije naar Nederland gebracht door de ambassadeur Cornelis Calkoen en door zijn neef Nicolaas in 1817 gelegateerd aan de Directie van de Levantsche Handel te Amsterdam.\n<i>Collection:</i> schilderijen; Vanmour serie","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}}}]},"34251561":{"pageid":34251561,"ns":6,"title":"File:Cornelis Calkoen op weg naar de audi\u00ebntie bij sultan Ahmed III Rijksmuseum SK-A-4076.jpeg","index":6,"imagerepository":"local","imageinfo":[{"size":4333588,"width":5914,"height":4256,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0c/Cornelis_Calkoen_op_weg_naar_de_audi%C3%ABntie_bij_sultan_Ahmed_III_Rijksmuseum_SK-A-4076.jpeg/1920px-Cornelis_Calkoen_op_weg_naar_de_audi%C3%ABntie_bij_sultan_Ahmed_III_Rijksmuseum_SK-A-4076.jpeg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":1151,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0c/Cornelis_Calkoen_op_weg_naar_de_audi%C3%ABntie_bij_sultan_Ahmed_III_Rijksmuseum_SK-A-4076.jpeg/3840px-Cornelis_Calkoen_op_weg_naar_de_audi%C3%ABntie_bij_sultan_Ahmed_III_Rijksmuseum_SK-A-4076.jpeg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0c/Cornelis_Calkoen_op_weg_naar_de_audi%C3%ABntie_bij_sultan_Ahmed_III_Rijksmuseum_SK-A-4076.jpeg/1920px-Cornelis_Calkoen_op_weg_naar_de_audi%C3%ABntie_bij_sultan_Ahmed_III_Rijksmuseum_SK-A-4076.jpeg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":1151,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0c/Cornelis_Calkoen_op_weg_naar_de_audi%C3%ABntie_bij_sultan_Ahmed_III_Rijksmuseum_SK-A-4076.jpeg/3840px-Cornelis_Calkoen_op_weg_naar_de_audi%C3%ABntie_bij_sultan_Ahmed_III_Rijksmuseum_SK-A-4076.jpeg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/0/0c/Cornelis_Calkoen_op_weg_naar_de_audi%C3%ABntie_bij_sultan_Ahmed_III_Rijksmuseum_SK-A-4076.jpeg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Cornelis_Calkoen_op_weg_naar_de_audi%C3%ABntie_bij_sultan_Ahmed_III_Rijksmuseum_SK-A-4076.jpeg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=34251561","extmetadata":{"ImageDescription":{"value":"<div class=\"description\">\nAmbassador Cornelis Calkoen walks through the second courtyard of the sultan's palace, where a banquet for the <a href=\"https://en.wikipedia.org/wiki/Janissaries\" class=\"extiw\" title=\"en:Janissaries\">Janissaries</a> is held. He is on his way to an audience with sultan <a href=\"https://en.wikipedia.org/wiki/Ahmed_III\" class=\"extiw\" title=\"en:Ahmed III\">Ahmed III</a> on 14 September 1727. The procession is led by two officials with high hats and silver staffs, followed by two interpretors, the ambassador and his entourage. In the background the Janissaries are throwing themselves on the sishes of rice. Part of a series of paintings with Ottoman subjects brought to the Netherlands from Turkey by ambassador Cornelis Calkoen and bequaethed to the Board of Directors of the Levantsche Handel in Amsterdam in 1817.</div>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}}}]},"34319448":{"pageid":34319448,"ns":6,"title":"File:De grootvizier Nev\u015fehirli Damat \u012cbrahim Pasa Rijksmuseum SK-A-2017.jpeg","index":1,"imagerepository":"local","imageinfo":[{"size":4541443,"width":4248,"height":5398,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c2/De_grootvizier_Nev%C5%9Fehirli_Damat_%C4%ACbrahim_Pasa_Rijksmuseum_SK-A-2017.jpeg/1920px-De_grootvizier_Nev%C5%9Fehirli_Damat_%C4%ACbrahim_Pasa_Rijksmuseum_SK-A-2017.jpeg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":2033,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c2/De_grootvizier_Nev%C5%9Fehirli_Damat_%C4%ACbrahim_Pasa_Rijksmuseum_SK-A-2017.jpeg/3840px-De_grootvizier_Nev%C5%9Fehirli_Damat_%C4%ACbrahim_Pasa_Rijksmuseum_SK-A-2017.jpeg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c2/De_grootvizier_Nev%C5%9Fehirli_Damat_%C4%ACbrahim_Pasa_Rijksmuseum_SK-A-2017.jpeg/1920px-De_grootvizier_Nev%C5%9Fehirli_Damat_%C4%ACbrahim_Pasa_Rijksmuseum_SK-A-2017.jpeg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":2033,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c2/De_grootvizier_Nev%C5%9Fehirli_Damat_%C4%ACbrahim_Pasa_Rijksmuseum_SK-A-2017.jpeg/3840px-De_grootvizier_Nev%C5%9Fehirli_Damat_%C4%ACbrahim_Pasa_Rijksmuseum_SK-A-2017.jpeg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/c/c2/De_grootvizier_Nev%C5%9Fehirli_Damat_%C4%ACbrahim_Pasa_Rijksmuseum_SK-A-2017.jpeg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:De_grootvizier_Nev%C5%9Fehirli_Damat_%C4%ACbrahim_Pasa_Rijksmuseum_SK-A-2017.jpeg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=34319448","extmetadata":{"ImageDescription":{"value":"Portret van de grootvizier Nevsehirli Damat Ibrahim Pasa, staande, ten voeten uit. \u01cfbrahim Pasha is gekleed in een witte satijnen kaftan gevoerd met sabelbont en een kall\u00e2v\u00ee, een ceremoni\u00eble tulband waar men de vizieren aan kon herkennen. De grootvizier droeg een gouden band over de tulband ter onderscheid van de vizieren, die een zwarte band droegen.  Op de achtergrond zien we de sofa of bank die ook op het tweede audi\u00ebntieschilderij in de divan is te zien. De grootvizier is door Vanmour geplaatst in een bestuurlijke omgeving, om zijn functie te onderstrepen.\n<i>Collection:</i> schilderijen; Vanmour serie","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}}}]},"34318970":{"pageid":34318970,"ns":6,"title":"File:De grootvizier Rijksmuseum SK-A-2018.jpeg","index":4,"imagerepository":"local","imageinfo":[{"size":4234576,"width":4108,"height":5252,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c2/De_grootvizier_Rijksmuseum_SK-A-2018.jpeg/1920px-De_grootvizier_Rijksmuseum_SK-A-2018.jpeg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":2046,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c2/De_grootvizier_Rijksmuseum_SK-A-2018.jpeg/3840px-De_grootvizier_Rijksmuseum_SK-A-2018.jpeg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c2/De_grootvizier_Rijksmuseum_SK-A-2018.jpeg/1920px-De_grootvizier_Rijksmuseum_SK-A-2018.jpeg?utm_so